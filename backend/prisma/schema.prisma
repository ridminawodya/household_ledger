generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String?
  googleId       String?   @unique
  name           String
  createdAt      DateTime  @default(now())
  plan           String    @default("free")
  premiumSince   DateTime?

  memberships       GroupMember[]
  expensesPaid      Expense[]        @relation("ExpensePaidBy")
  expenseShares     ExpenseShare[]
  choreAssignments  ChoreAssignment[]
  groupsCreated     Group[]          @relation("GroupCreatedBy")
  settlementsPaid   Settlement[]     @relation("SettlementFrom")
  settlementsRecv   Settlement[]     @relation("SettlementTo")
  notifications     Notification[]
}

model Group {
  id          String   @id @default(uuid())
  name        String
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  createdById String?

  createdBy   User?         @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members     GroupMember[]
  expenses    Expense[]
  chores      Chore[]
  settlements Settlement[]
  categories  GroupCategory[]
  notifications Notification[]
}

model GroupCategory {
  id      String @id @default(uuid())
  groupId String
  name    String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  type      String
  actorName String
  message   String
  amountCents Int?
  createdAt DateTime @default(now())
  readAt    DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model GroupMember {
  id       String   @id @default(uuid())
  userId   String
  groupId  String
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Expense {
  id          String    @id @default(uuid())
  groupId     String
  paidById    String
  description String
  amountCents Int
  category    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  receiptUrl  String?

  // Recurrence: a non-null recurrenceFrequency marks this expense as the
  // template for a recurring series. nextOccurrenceAt is checked lazily
  // (on read) rather than via a background job, since the free-tier host
  // has no reliable always-on scheduler.
  recurrenceFrequency String?
  nextOccurrenceAt    DateTime?
  recurrenceSourceId  String?

  group             Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy            User           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  shares            ExpenseShare[]
  recurrenceSource  Expense?       @relation("ExpenseRecurrence", fields: [recurrenceSourceId], references: [id], onDelete: SetNull)
  recurrenceInstances Expense[]    @relation("ExpenseRecurrence")
}

model ExpenseShare {
  id          String @id @default(uuid())
  expenseId   String
  userId      String
  amountCents Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model Settlement {
  id          String   @id @default(uuid())
  groupId     String
  fromUserId  String
  toUserId    String
  amountCents Int
  createdAt   DateTime @default(now())

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id])
}

model Chore {
  id        String   @id @default(uuid())
  groupId   String
  title     String
  frequency String
  autoRotate Boolean @default(false)
  createdAt DateTime @default(now())

  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignments ChoreAssignment[]
}

model ChoreAssignment {
  id          String    @id @default(uuid())
  choreId     String
  userId      String
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}
